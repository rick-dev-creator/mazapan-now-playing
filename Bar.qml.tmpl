// Generated by mazapan (plugin {{ plugin }}): what's playing, beside the clock.
//
// Its little bars follow the sound while it plays (on their own, without
// cava) and settle when it stops; the title
// and the artist, gliding when long while the pointer is on it. A click
// opens the panel; a right click plays or pauses; a middle click skips;
// the wheel changes its volume.

import QtQuick
import Quickshell
import qs
import "../../components/kit"
import "../../components/now-playing"

BarItem {
  id: root

  readonly property var np: NowPlaying
  readonly property bool elastic: true

  shown: np.inBar && np.has
  acceptedButtons: Qt.LeftButton | Qt.RightButton | Qt.MiddleButton
  onClicked: mouse => {
    if (mouse.button === Qt.RightButton) np.toggle()
    else if (mouse.button === Qt.MiddleButton) np.next()
    else Quickshell.execDetached(["qs", "ipc", "-c", "mazapan", "call", "mazapan", "panel", "now-playing"])
  }
  onWheel: event => {
    if (np.player && np.player.volumeSupported) np.setVolume(np.player.volume + (event.angleDelta.y > 0 ? 0.05 : -0.05))
  }

  Bars {
    anchors.verticalCenter: parent.verticalCenter
    width: 14
    height: 12
    count: 4
    gap: 2
    rest: 0.25
    levels: root.np.levels
    breathing: root.np.levels.length === 0
    playing: root.np.playing
    tint: root.np.playing ? root.np.tint : Theme.fgMuted
  }

  Marquee {
    id: words
    anchors.verticalCenter: parent.verticalCenter
    width: Math.min(implicitWidth, 260)
    running: hover.hovered
    text: root.np.artist !== "" ? root.np.title + " · " + root.np.artist : root.np.title
    color: root.np.playing ? Theme.fg : Theme.fgMuted
    family: Theme.fontMono
    pixelSize: Theme.fontSize * 1.25
    opacity: 1
    Behavior on opacity { enabled: Theme.motion; NumberAnimation { duration: 160 } }
  }

  HoverHandler { id: hover }

  // A new song: the words dip and come back.
  Connections {
    target: root.np
    function onTrackChanged() { if (Theme.motion) dip.restart() }
  }
  SequentialAnimation {
    id: dip
    NumberAnimation { target: words; property: "opacity"; to: 0; duration: 120 }
    NumberAnimation { target: words; property: "opacity"; to: 1; duration: 280; easing.type: Easing.OutCubic }
  }
}
