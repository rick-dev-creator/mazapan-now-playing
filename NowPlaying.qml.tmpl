// Generated by mazapan (plugin {{ plugin }}): what's playing, for the bar,
// the Control Center and the panel.
//
// Every app that says what it plays over MPRIS (Spotify, a browser, mpv…)
// is a player. The one shown is the one picked by hand, else the last one
// that started playing, else one playing, else the first: when another
// starts, it takes over, as on a phone. Its cover gives the colors; cava,
// while someone is looking, the sound as bars.

pragma Singleton

import QtQuick
import Quickshell
import Quickshell.Io
import Quickshell.Services.Mpris
import qs

Singleton {
  id: root

  // --- the settings, read live -------------------------------------------------

  readonly property var settings: Object.assign({ bar: true, visualizer: true, artwork_colors: true }, stored)
  property var stored: ({})
  readonly property bool inBar: settings.bar
  readonly property bool drawSound: settings.visualizer
  readonly property bool coverColors: settings.artwork_colors

  FileView {
    path: Quickshell.shellPath("components/now-playing/settings.json")
    blockLoading: true
    watchChanges: true
    printErrors: false
    onFileChanged: reload()
    onLoaded: {
      try { root.stored = JSON.parse(text()) } catch (e) {}
    }
  }

  // --- the players --------------------------------------------------------------

  readonly property var players: Mpris.players.values
  // dbusName of the one picked by hand; of the last one that started playing.
  property string pinned: ""
  property string lastPlaying: ""

  readonly property var player: {
    const ps = players
    return ps.find(p => p.dbusName === pinned)
      ?? ps.find(p => p.dbusName === lastPlaying)
      ?? ps.find(p => p.isPlaying)
      ?? ps[0] ?? null
  }

  Instantiator {
    model: Mpris.players
    Connections {
      required property var modelData
      target: modelData
      function onIsPlayingChanged() {
        if (!modelData.isPlaying) return
        root.lastPlaying = modelData.dbusName
        root.pinned = ""
      }
    }
  }

  // --- what it plays ------------------------------------------------------------

  readonly property bool has: player !== null && title !== ""
  readonly property bool playing: player !== null && player.isPlaying
  readonly property string title: player ? (player.trackTitle || player.identity || "") : ""
  readonly property string artist: player ? (player.trackArtist || "") : ""
  readonly property string album: player ? (player.trackAlbum || "") : ""
  readonly property string art: player ? (player.trackArtUrl || "") : ""
  readonly property string app: player ? (player.identity || "") : ""
  readonly property string appIcon: iconOf(player)
  // Changes when the song does: what the animations follow.
  readonly property string track: player ? [player.dbusName, title, artist].join("\n") : ""

  function iconOf(p) {
    if (!p) return ""
    const entry = p.desktopEntry ? DesktopEntries.heuristicLookup(p.desktopEntry) : null
    return Quickshell.iconPath(entry ? entry.icon : (p.desktopEntry || p.identity || "").toLowerCase(), true)
  }

  // A live stream says its length is endless (or doesn't say): none.
  readonly property real length: player && player.lengthSupported && player.length > 0 && player.length < 86400 * 2 ? player.length : 0
  property real position: 0
  readonly property real progress: length > 0 ? Math.max(0, Math.min(1, position / length)) : 0
  readonly property bool canSeek: player !== null && player.canSeek && player.positionSupported && length > 0

  // The position isn't told as it moves: asked for, twice a second while it plays.
  Timer {
    interval: 500
    repeat: true
    running: root.playing
    triggeredOnStart: true
    onTriggered: root.sync()
  }
  onPlayerChanged: sync()
  onTrackChanged: sync()
  Connections {
    target: root.player
    ignoreUnknownSignals: true
    function onPositionChanged() { root.position = root.player.position }
    function onPostTrackChanged() { root.sync() }
  }
  function sync() { position = player && player.positionSupported ? player.position : 0 }

  function time(seconds) {
    const s = Math.max(0, Math.floor(seconds))
    const h = Math.floor(s / 3600), m = Math.floor(s / 60) % 60, r = s % 60
    return (h > 0 ? h + ":" + String(m).padStart(2, "0") : m) + ":" + String(r).padStart(2, "0")
  }

  // --- what it does --------------------------------------------------------------

  function toggle() { if (player && player.canTogglePlaying) player.togglePlaying() }
  function next() { if (player && player.canGoNext) player.next() }
  function previous() {
    if (!player) return
    // As every player does: back to the start first, the song before when already there.
    if (canSeek && position > 4) seekTo(0)
    else if (player.canGoPrevious) player.previous()
  }
  function seekTo(seconds) {
    if (!canSeek) return
    player.position = Math.max(0, Math.min(length - 0.5, seconds))
    position = player.position
  }
  function seekBy(seconds) { seekTo(position + seconds) }
  function setVolume(v) { if (player && player.volumeSupported) player.volume = Math.max(0, Math.min(1, v)) }
  function shuffle() { if (player && player.shuffleSupported) player.shuffle = !player.shuffle }
  function cycleLoop() {
    if (!player || !player.loopSupported) return
    player.loopState = player.loopState === MprisLoopState.None ? MprisLoopState.Playlist
      : player.loopState === MprisLoopState.Playlist ? MprisLoopState.Track : MprisLoopState.None
  }
  function pick(p) { if (p) pinned = p.dbusName }
  function cycle(step) {
    const ps = players
    if (ps.length < 2) return
    const i = Math.max(0, ps.indexOf(player))
    pick(ps[(i + step + ps.length) % ps.length])
  }

  IpcHandler {
    target: "nowplaying"
    function toggle(): void { root.toggle() }
    function next(): void { root.next() }
    function previous(): void { root.previous() }
  }

  // --- the cover's colors ----------------------------------------------------------

  ColorQuantizer {
    id: quantizer
    source: root.coverColors && root.art !== "" ? root.art : ""
    depth: 3
    rescaleSize: 64
  }

  // The most alive color of the cover that isn't near black or white.
  readonly property color found: {
    let best = null, score = -1
    for (const c of quantizer.colors) {
      const s = c.hslSaturation, l = c.hslLightness
      const sc = s * (1 - Math.abs(l - 0.55) * 1.4) + 0.05
      if (l > 0.08 && l < 0.95 && sc > score) { score = sc; best = c }
    }
    return best ?? Theme.accent
  }
  readonly property bool light: Theme.mode === "light"
  readonly property bool tinted: coverColors && art !== "" && quantizer.colors.length > 0
  // What's drawn in the cover's color (the bar that moves, the play button,
  // the bars), readable on the theme; and a deep wash of it behind.
  readonly property color tint: !tinted ? Theme.accent
    : Qt.hsla(found.hslHue, Math.max(0.42, Math.min(0.85, found.hslSaturation)),
              light ? Math.min(0.42, Math.max(0.3, found.hslLightness)) : Math.max(0.6, Math.min(0.74, found.hslLightness)), 1)
  readonly property color wash: !tinted ? Theme.accentDeep
    : Qt.hsla(found.hslHue, Math.min(0.55, found.hslSaturation * 0.8), light ? 0.9 : 0.17, 1)
  // Text on the tint.
  readonly property color onTint: tint.hslLightness > 0.55 ? "#141414" : "#ffffff"

  // --- the sound, as bars (cava) ------------------------------------------------------

  // Who's looking: the panel, the Control Center. Nobody, cava rests.
  property bool panelOpen: false
  property bool centerOpen: false
  property bool hasCava: false
  readonly property bool listening: drawSound && hasCava && playing && (panelOpen || centerOpen)
  property var levels: []

  Process {
    running: true
    command: ["sh", "-c", "command -v cava"]
    onExited: code => root.hasCava = code === 0
  }

  Process {
    running: root.listening
    command: ["cava", "-p", Quickshell.shellPath("components/now-playing/cava.conf")]
    stdout: SplitParser {
      onRead: line => {
        const v = line.split(";")
        v.pop()
        root.levels = v.map(x => Math.min(1, Number(x) / 100))
      }
    }
    onRunningChanged: if (!running) root.levels = []
  }
}
