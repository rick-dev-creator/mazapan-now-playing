// Generated by mazapan (plugin {{ plugin }}).
//
// Now Playing: drops from the bar over the cover's blurred light. The
// cover, big, floating while it plays and settling back when paused; the
// title and the artist; a bar to drag through the song; shuffle, back,
// play, next and repeat; the sound drawn as it plays; its volume; and every
// player at once, to switch between them.
//
// Space plays or pauses, ← → move 5 seconds, ↑ ↓ the volume, N and P skip,
// S shuffles, R repeats, Tab goes to the next player, Esc closes; so does a
// click outside.

import QtQuick
import QtQuick.Layouts
import QtQuick.Effects
import Quickshell
import Quickshell.Wayland
import Quickshell.Hyprland
import Quickshell.Services.Mpris
import qs
import "../components/kit"
import "../components/now-playing"

Item {
  id: root

  property bool open: false
  property var screenAtOpen: null
  readonly property var np: NowPlaying

  function toggle() { open ? close() : show() }
  function show() {
    screenAtOpen = Quickshell.screens.find(s => Hyprland.focusedMonitor && s.name === Hyprland.focusedMonitor.name) ?? Quickshell.screens[0]
    open = true
    Qt.callLater(() => keys.forceActiveFocus())
  }
  function close() { open = false }

  Binding { target: NowPlaying; property: "panelOpen"; value: root.open }

  PanelWindow {
    id: win
    // Stays up while it closes, until the card is gone.
    visible: root.open || card.opacity > 0.01
    screen: root.screenAtOpen
    // The whole screen below the bar, clear but for the card: a click
    // anywhere else lands here and closes it. (A layer that holds the
    // keyboard gets the clicks of the whole screen, so it has to be the one
    // to catch them.)
    anchors.top: true
    anchors.bottom: true
    anchors.left: true
    anchors.right: true
    color: "transparent"
    exclusionMode: ExclusionMode.Normal
    WlrLayershell.layer: WlrLayer.Overlay
    // "mazapan-panel-…": SUPER + Q closes it (see hypr-base).
    WlrLayershell.namespace: "mazapan-panel-now-playing"
    WlrLayershell.keyboardFocus: root.open ? WlrKeyboardFocus.Exclusive : WlrKeyboardFocus.None
    // Closing, it lets the clicks through at once.
    mask: Region { item: root.open ? win.contentItem : null }

    MouseArea {
      anchors.fill: parent
      enabled: root.open
      acceptedButtons: Qt.AllButtons
      onPressed: root.close()
    }

    Item {
      id: card
      anchors.horizontalCenter: parent.horizontalCenter
      width: 380
      implicitHeight: content.implicitHeight + 44

      // In: from a little above and smaller, with a spring; out: quicker.
      opacity: root.open ? 1 : 0
      scale: root.open ? 1 : 0.94
      y: root.open ? Theme.gapOut : -6
      transformOrigin: Item.Top
      Behavior on opacity { enabled: Theme.motion; NumberAnimation { duration: root.open ? 220 : 160; easing.type: Easing.OutCubic } }
      Behavior on scale { enabled: Theme.motion; NumberAnimation { duration: root.open ? 420 : 160; easing.type: root.open ? Easing.OutBack : Easing.InCubic; easing.overshoot: 1.4 } }
      Behavior on y { enabled: Theme.motion; NumberAnimation { duration: root.open ? 420 : 160; easing.type: root.open ? Easing.OutBack : Easing.InCubic } }

      RectangularShadow {
        anchors.fill: parent
        radius: Theme.radius
        blur: 30
        offset.y: 10
        color: Qt.rgba(0, 0, 0, Theme.mode === "light" ? 0.22 : 0.5)
      }

      Backdrop {
        anchors.fill: parent
        source: root.np.coverColors ? root.np.art : ""
        wash: root.np.wash
        strength: Theme.mode === "light" ? 0.42 : 0.62
      }
      Rectangle {
        anchors.fill: parent
        color: "transparent"
        radius: Theme.radius
        border.width: 1
        border.color: Theme.border
      }

      // A click on the card itself (between its parts) isn't one outside it.
      MouseArea {
        anchors.fill: parent
        acceptedButtons: Qt.AllButtons
      }

      FocusScope {
        id: keys
        anchors.fill: parent
        focus: true
        Keys.onPressed: event => {
          const p = root.np.player
          if (event.key === Qt.Key_Escape) root.close()
          else if (event.key === Qt.Key_Space) root.np.toggle()
          else if (event.key === Qt.Key_Left) root.np.seekBy(-5)
          else if (event.key === Qt.Key_Right) root.np.seekBy(5)
          else if (event.key === Qt.Key_Up && p) root.np.setVolume(p.volume + 0.05)
          else if (event.key === Qt.Key_Down && p) root.np.setVolume(p.volume - 0.05)
          else if (event.key === Qt.Key_N) root.np.next()
          else if (event.key === Qt.Key_P) root.np.previous()
          else if (event.key === Qt.Key_S) root.np.shuffle()
          else if (event.key === Qt.Key_R) root.np.cycleLoop()
          else if (event.key === Qt.Key_Tab) root.np.cycle(1)
          else if (event.key === Qt.Key_Backtab) root.np.cycle(-1)
          else return
          event.accepted = true
        }

        ColumnLayout {
          id: content
          x: 22
          y: 22
          width: parent.width - 44
          spacing: 14

          // --- whose it is ------------------------------------------------------
          RowLayout {
            Layout.fillWidth: true
            spacing: 8
            Image {
              Layout.preferredWidth: 16
              Layout.preferredHeight: 16
              sourceSize: Qt.size(32, 32)
              source: root.np.appIcon
              visible: status === Image.Ready
            }
            Caption {
              Layout.fillWidth: true
              text: root.np.has ? root.np.app.toUpperCase() : {{ tq "title" }}
              color: Theme.fgMuted
            }
            Caption {
              visible: root.np.players.length > 1
              text: {{ tq "players" }}.arg(root.np.players.length)
              font.letterSpacing: 0
              color: Theme.fgMuted
            }
          }

          // --- the cover ------------------------------------------------------------
          Item {
            Layout.fillWidth: true
            Layout.preferredHeight: content.width

            Cover {
              anchors.centerIn: parent
              width: content.width
              height: content.width
              source: root.np.art
              wash: root.np.wash
              shadow: true
              radius: Math.min(Theme.radius * 2, 18)
              // Playing, it floats; paused, it settles back.
              scale: root.np.playing || !root.np.has ? 1 : 0.84
              Behavior on scale { enabled: Theme.motion; SpringAnimation { spring: 2.4; damping: 0.26; epsilon: 0.001 } }
            }

            // Nothing playing anywhere.
            Label {
              anchors.centerIn: parent
              anchors.verticalCenterOffset: parent.height * 0.3
              visible: !root.np.has
              text: {{ tq "nothing" }}
              color: Theme.fgMuted
            }
          }

          // --- the song --------------------------------------------------------------
          ColumnLayout {
            Layout.fillWidth: true
            spacing: 3
            visible: root.np.has
            TrackText {
              Layout.fillWidth: true
              text: root.np.title
              bold: true
              pixelSize: Theme.fontSize * 1.75
            }
            TrackText {
              Layout.fillWidth: true
              delay: 70
              text: [root.np.artist, root.np.album].filter(s => s).join(" — ")
              color: Theme.fgMuted
              pixelSize: Theme.fontSize * 1.3
            }
          }

          // --- how far along -----------------------------------------------------------
          ColumnLayout {
            Layout.fillWidth: true
            spacing: 2
            // Always in its place, so the panel doesn't jump when a player
            // stops saying how long the song is (Firefox, while it plays).
            visible: root.np.has
            opacity: root.np.length > 0 ? 1 : 0.35
            Behavior on opacity { enabled: Theme.motion; NumberAnimation { duration: 250 } }
            Seek {
              Layout.fillWidth: true
              value: root.np.progress
              interactive: root.np.canSeek
              tint: root.np.tint
              onMoved: fraction => root.np.seekTo(fraction * root.np.length)
            }
            RowLayout {
              Layout.fillWidth: true
              Caption { text: root.np.length > 0 ? root.np.time(root.np.position) : ""; font.letterSpacing: 0; font.family: Theme.fontMono; color: Theme.fgMuted }
              Item { Layout.fillWidth: true }
              Caption { text: root.np.length > 0 ? "-" + root.np.time(root.np.length - root.np.position) : ""; font.letterSpacing: 0; font.family: Theme.fontMono; color: Theme.fgMuted }
            }
          }

          // --- the buttons --------------------------------------------------------------
          RowLayout {
            Layout.alignment: Qt.AlignHCenter
            spacing: 18
            visible: root.np.has
            readonly property var p: root.np.player

            Control {
              glyph: "󰒝"
              size: 32
              on: parent.p !== null && parent.p.shuffleSupported && parent.p.shuffle
              tint: root.np.tint
              enabled: parent.p !== null && parent.p.shuffleSupported
              onClicked: root.np.shuffle()
            }
            Control {
              glyph: "󰒮"
              size: 44
              enabled: parent.p !== null && (parent.p.canGoPrevious || root.np.canSeek)
              onClicked: root.np.previous()
            }
            Control {
              glyph: root.np.playing ? "󰏤" : "󰐊"
              size: 64
              filled: true
              tint: root.np.tint
              ink: root.np.onTint
              enabled: parent.p !== null && parent.p.canTogglePlaying
              onClicked: root.np.toggle()
            }
            Control {
              glyph: "󰒭"
              size: 44
              enabled: parent.p !== null && parent.p.canGoNext
              onClicked: root.np.next()
            }
            Control {
              glyph: parent.p !== null && parent.p.loopState === MprisLoopState.Track ? "󰑘" : "󰑖"
              size: 32
              on: parent.p !== null && parent.p.loopSupported && parent.p.loopState !== MprisLoopState.None
              tint: root.np.tint
              enabled: parent.p !== null && parent.p.loopSupported
              onClicked: root.np.cycleLoop()
            }
          }

          // --- the sound ------------------------------------------------------------------
          Bars {
            Layout.fillWidth: true
            Layout.preferredHeight: root.np.has && root.np.drawSound && root.np.hasCava ? 40 : 0
            visible: Layout.preferredHeight > 0.5
            count: 48
            levels: root.np.levels
            playing: root.np.playing
            tint: root.np.tint
          }

          // --- its volume -------------------------------------------------------------------
          RowLayout {
            Layout.fillWidth: true
            spacing: 10
            visible: root.np.player !== null && root.np.player.volumeSupported
            Glyph { text: "󰕿"; color: Theme.fgMuted }
            Seek {
              Layout.fillWidth: true
              value: root.np.player ? root.np.player.volume : 0
              tint: Theme.fg
              thin: 4
              thick: 7
              onMoved: fraction => root.np.setVolume(fraction)
            }
            Glyph { text: "󰕾"; color: Theme.fgMuted }
          }

          // --- every player ------------------------------------------------------------------
          Flow {
            Layout.fillWidth: true
            spacing: 8
            visible: root.np.players.length > 1
            Repeater {
              model: root.np.players
              Rectangle {
                id: chip
                required property var modelData
                readonly property bool current: modelData === root.np.player
                width: row.implicitWidth + 16
                height: 34
                radius: Theme.radius > 0 ? height / 2 : 0
                color: current ? Qt.alpha(root.np.tint, 0.22) : Qt.alpha(Theme.fg, hover.hovered ? 0.1 : 0.05)
                border.width: 1
                border.color: current ? Qt.alpha(root.np.tint, 0.6) : "transparent"
                Behavior on color { enabled: Theme.motion; ColorAnimation { duration: 220 } }
                Behavior on border.color { enabled: Theme.motion; ColorAnimation { duration: 220 } }
                HoverHandler { id: hover; cursorShape: Qt.PointingHandCursor }
                TapHandler { onTapped: root.np.pick(chip.modelData) }

                Row {
                  id: row
                  anchors.centerIn: parent
                  spacing: 7
                  Cover {
                    anchors.verticalCenter: parent.verticalCenter
                    width: 22
                    height: 22
                    radius: Math.min(Theme.radius, 5)
                    source: chip.modelData.trackArtUrl || ""
                  }
                  // The song, so two players of one app tell apart; the app when it plays none.
                  Text {
                    anchors.verticalCenter: parent.verticalCenter
                    width: Math.min(implicitWidth, 96)
                    elide: Text.ElideRight
                    text: chip.modelData.trackTitle || chip.modelData.identity
                    color: chip.current ? Theme.fg : Theme.fgMuted
                    font.family: Theme.fontUi
                    font.pixelSize: Theme.fontSize * 1.15
                  }
                  Bars {
                    anchors.verticalCenter: parent.verticalCenter
                    width: 10
                    height: 10
                    count: 3
                    rest: 0.3
                    breathing: true
                    visible: chip.modelData.isPlaying
                    playing: chip.modelData.isPlaying
                    tint: chip.current ? root.np.tint : Theme.fgMuted
                  }
                }
              }
            }
          }

          Caption {
            Layout.fillWidth: true
            Layout.preferredWidth: content.width
            text: {{ tq "keys" }}
            font.letterSpacing: 0
            color: Theme.fgSubtle
            wrapMode: Text.WordWrap
            horizontalAlignment: Text.AlignHCenter
          }
        }
      }
    }
  }
}
