// Generated by mazapan (plugin {{ plugin }}): what's playing, in the
// Control Center, in place of its music.
//
// On its cover's blurred light: the cover, the title and the artist, the
// buttons, a bar to drag through the song with its times, and the sound
// drawn beneath while it plays. With more than one player, a dot for each,
// to switch. The cover or the title open the panel.

import QtQuick
import QtQuick.Layouts
import Quickshell
import qs
import "../../components/kit"
import "../../components/control"
import "../../components/now-playing"

Item {
  id: root

  readonly property var np: NowPlaying
  property bool shown: np.has

  Layout.fillWidth: true
  implicitHeight: body.implicitHeight + 28

  Binding { target: NowPlaying; property: "centerOpen"; value: ControlService.open && root.shown }

  function openPanel() {
    ControlService.close()
    Quickshell.execDetached(["qs", "ipc", "-c", "mazapan", "call", "mazapan", "panel", "now-playing"])
  }

  Backdrop {
    anchors.fill: parent
    source: root.np.coverColors ? root.np.art : ""
    wash: root.np.wash
    base: Theme.surface
    strength: 0.5
  }
  Rectangle {
    anchors.fill: parent
    color: "transparent"
    radius: Theme.radius
    border.width: 1
    border.color: Theme.border
  }

  ColumnLayout {
    id: body
    x: 14
    y: 14
    width: parent.width - 28
    spacing: 10

    RowLayout {
      Layout.fillWidth: true
      spacing: 12

      Cover {
        Layout.preferredWidth: 64
        Layout.preferredHeight: 64
        source: root.np.art
        wash: root.np.wash
        shadow: true
        radius: Math.min(Theme.radius * 1.5, 14)
        scale: root.np.playing ? 1 : 0.9
        Behavior on scale { enabled: Theme.motion; SpringAnimation { spring: 3; damping: 0.32; epsilon: 0.002 } }
        MouseArea { anchors.fill: parent; cursorShape: Qt.PointingHandCursor; onClicked: root.openPanel() }
      }

      ColumnLayout {
        Layout.fillWidth: true
        spacing: 2

        TrackText {
          Layout.fillWidth: true
          text: root.np.title
          bold: true
          pixelSize: Theme.fontSize * 1.4
          MouseArea { anchors.fill: parent; cursorShape: Qt.PointingHandCursor; onClicked: root.openPanel() }
        }
        TrackText {
          Layout.fillWidth: true
          delay: 60
          text: root.np.artist || root.np.album
          color: Theme.fgMuted
          pixelSize: Theme.fontSize * 1.2
          visible: text !== ""
        }
        Row {
          spacing: 5
          opacity: 0.8
          Image {
            anchors.verticalCenter: parent.verticalCenter
            width: 12
            height: 12
            sourceSize: Qt.size(24, 24)
            source: root.np.appIcon
            visible: status === Image.Ready
          }
          Caption {
            anchors.verticalCenter: parent.verticalCenter
            text: root.np.app
            font.letterSpacing: 0
          }
        }
      }

      Row {
        spacing: 2
        Control {
          anchors.verticalCenter: parent.verticalCenter
          glyph: "󰒮"
          size: 32
          enabled: root.np.player !== null && (root.np.player.canGoPrevious || root.np.canSeek)
          onClicked: root.np.previous()
        }
        Control {
          anchors.verticalCenter: parent.verticalCenter
          glyph: root.np.playing ? "󰏤" : "󰐊"
          size: 40
          filled: true
          tint: root.np.tint
          ink: root.np.onTint
          enabled: root.np.player !== null && root.np.player.canTogglePlaying
          onClicked: root.np.toggle()
        }
        Control {
          anchors.verticalCenter: parent.verticalCenter
          glyph: "󰒭"
          size: 32
          enabled: root.np.player !== null && root.np.player.canGoNext
          onClicked: root.np.next()
        }
      }
    }

    ColumnLayout {
      Layout.fillWidth: true
      spacing: 2
      visible: root.np.length > 0

      Seek {
        Layout.fillWidth: true
        value: root.np.progress
        interactive: root.np.canSeek
        tint: root.np.tint
        thin: 3
        thick: 6
        onMoved: fraction => root.np.seekTo(fraction * root.np.length)
      }
      RowLayout {
        Layout.fillWidth: true
        Caption { text: root.np.time(root.np.position); font.letterSpacing: 0; font.family: Theme.fontMono; color: Theme.fgMuted }
        Item { Layout.fillWidth: true }
        Caption { text: "-" + root.np.time(root.np.length - root.np.position); font.letterSpacing: 0; font.family: Theme.fontMono; color: Theme.fgMuted }
      }
    }

    Bars {
      Layout.fillWidth: true
      Layout.preferredHeight: root.np.listening ? 22 : 0
      visible: Layout.preferredHeight > 0.5
      count: 40
      levels: root.np.levels
      playing: root.np.playing
      tint: root.np.tint
      opacity: 0.85
      Behavior on Layout.preferredHeight { enabled: Theme.motion; NumberAnimation { duration: 260; easing.type: Easing.OutCubic } }
    }

    // More than one player: a dot each, the one shown long.
    Row {
      Layout.alignment: Qt.AlignHCenter
      spacing: 6
      visible: root.np.players.length > 1
      Repeater {
        model: root.np.players
        Rectangle {
          required property var modelData
          readonly property bool current: modelData === root.np.player
          anchors.verticalCenter: parent.verticalCenter
          width: current ? 18 : 6
          height: 6
          radius: Theme.radius > 0 ? 3 : 0
          color: current ? root.np.tint : Qt.alpha(Theme.fg, modelData.isPlaying ? 0.6 : 0.3)
          Behavior on width { enabled: Theme.motion; NumberAnimation { duration: 260; easing.type: Easing.OutBack } }
          Behavior on color { enabled: Theme.motion; ColorAnimation { duration: 260 } }
          MouseArea {
            anchors.fill: parent
            anchors.margins: -4
            cursorShape: Qt.PointingHandCursor
            onClicked: root.np.pick(parent.modelData)
          }
        }
      }
    }
  }
}
