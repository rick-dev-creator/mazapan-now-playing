// Generated by mazapan (plugin {{ plugin }}): a cover, in the theme's shape.
//
// A new one fades in over the old once it's loaded (never a blank between
// songs); none, a note on the cover's own wash. With `shadow`, it floats.

import QtQuick
import QtQuick.Effects
import qs
import "../kit"

Item {
  id: cover

  property string source: ""
  property real radius: Theme.radius
  property bool shadow: false
  property color wash: Theme.bgAlt

  // Two pictures, taking turns: the one in front, the one loading behind.
  property bool aFront: true
  onSourceChanged: {
    const back = aFront ? b : a
    if (back.source.toString() === source && back.status === Image.Ready) aFront = !aFront
    else back.source = source
  }
  Component.onCompleted: a.source = source

  RectangularShadow {
    visible: cover.shadow
    anchors.fill: art
    radius: cover.radius
    blur: cover.width * 0.12
    offset.y: cover.width * 0.05
    spread: -cover.width * 0.02
    color: Qt.rgba(0, 0, 0, Theme.mode === "light" ? 0.28 : 0.55)
  }

  Item {
    id: art
    anchors.fill: parent
    layer.enabled: cover.radius > 0
    layer.smooth: true
    layer.effect: MultiEffect {
      maskEnabled: true
      maskSource: mask
      maskThresholdMin: 0.5
      maskSpreadAtMin: 1
    }

    Rectangle {
      anchors.fill: parent
      gradient: Gradient {
        GradientStop { position: 0; color: Qt.lighter(cover.wash, 1.5) }
        GradientStop { position: 1; color: cover.wash }
      }
      Glyph {
        anchors.centerIn: parent
        text: "󰝚"
        font.pointSize: Math.max(8, cover.width * 0.27)
        color: Theme.fgSubtle
        visible: a.status !== Image.Ready && b.status !== Image.Ready
      }
    }

    Image {
      id: a
      anchors.fill: parent
      fillMode: Image.PreserveAspectCrop
      asynchronous: true
      cache: true
      sourceSize: Qt.size(cover.width * 2, cover.height * 2)
      opacity: cover.aFront && status === Image.Ready ? 1 : 0
      Behavior on opacity { enabled: Theme.motion; NumberAnimation { duration: 420; easing.type: Easing.OutCubic } }
      onStatusChanged: if (status === Image.Ready && source.toString() === cover.source && !cover.aFront) cover.aFront = true
    }
    Image {
      id: b
      anchors.fill: parent
      fillMode: Image.PreserveAspectCrop
      asynchronous: true
      cache: true
      sourceSize: Qt.size(cover.width * 2, cover.height * 2)
      opacity: !cover.aFront && status === Image.Ready ? 1 : 0
      Behavior on opacity { enabled: Theme.motion; NumberAnimation { duration: 420; easing.type: Easing.OutCubic } }
      onStatusChanged: if (status === Image.Ready && source.toString() === cover.source && cover.aFront) cover.aFront = false
    }

    // A hairline, so a dark cover keeps its edge on a dark panel.
    Rectangle {
      anchors.fill: parent
      color: "transparent"
      radius: cover.radius
      border.width: 1
      border.color: Qt.rgba(1, 1, 1, Theme.mode === "light" ? 0 : 0.08)
    }
  }

  Rectangle {
    id: mask
    anchors.fill: parent
    radius: cover.radius
    visible: false
    layer.enabled: true
    layer.smooth: true
  }
}
